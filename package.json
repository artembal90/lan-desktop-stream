{
  "name": "lan-desktop-stream-v2",
  "version": "0.3.0",
  "description": "Low-latency LAN desktop streaming",
  "main": "src/bootstrap.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.cjs",
    "lint": "node scripts/lint.cjs",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron scripts/electron-smoke.cjs",
    "smoke:package": "node scripts/package-smoke.cjs",
    "smoke:installer": "node scripts/installer-smoke.cjs",
    "verify-package": "node scripts/verify-package.cjs",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "10.9.1"
  },
  "build": {
    "appId": "com.example.landeskstream",
    "productName": "LAN Desktop Stream",
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app_icon_monitor.ico",
        "to": "app_icon_monitor.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app_icon_monitor.ico",
      "artifactName": "LAN-Desktop-Stream-${version}-Setup.${ext}"
    }
  }
}
